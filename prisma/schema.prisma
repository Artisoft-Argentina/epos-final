generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                Int            @id @default(autoincrement())
  name              String
  email             String         @unique
  emailVerifiedAt   DateTime?      @map("email_verified_at")
  password          String
  rememberToken     String?        @map("remember_token")
  roleId            Int?           @map("role_id")
  createdAt         DateTime       @default(now()) @map("created_at")
  updatedAt         DateTime       @updatedAt @map("updated_at")
  
  role              Role?          @relation(fields: [roleId], references: [id])
  facturas          Factura[]
  presupuestos      Presupuesto[]
  remitos           Remito[]

  @@map("users")
}

model Role {
  id          Int      @id @default(autoincrement())
  role        String
  permission  String?
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  
  users       User[]

  @@map("roles")
}

model Cliente {
  id              Int         @id @default(autoincrement())
  razonsocial     String
  documentounico  String?
  direccion       String?
  telefono        String?
  email           String?
  codigopostal    String?
  localidad       String?
  provincia       String?
  condicioniva    String?
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")
  
  facturas        Factura[]
  presupuestos    Presupuesto[]

  @@map("clientes")
}

model Categoria {
  id         Int        @id @default(autoincrement())
  categoria  String
  createdAt  DateTime   @default(now()) @map("created_at")
  updatedAt  DateTime   @updatedAt @map("updated_at")
  
  articulos  Articulo[]

  @@map("categorias")
}

model Marca {
  id         Int        @id @default(autoincrement())
  marca      String
  createdAt  DateTime   @default(now()) @map("created_at")
  updatedAt  DateTime   @updatedAt @map("updated_at")
  
  articulos  Articulo[]

  @@map("marcas")
}

model Supplier {
  id           Int          @id @default(autoincrement())
  razonsocial  String
  cuit         String?
  direccion    String?
  telefono     String?
  email        String?
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")
  deletedAt    DateTime?    @map("deleted_at")
  
  articulos    Articulo[]
  inventarios  Inventario[]
  remitos      Remito[]
  compras      Compra[]

  @@map("suppliers")
}

model Articulo {
  id                    Int                     @id @default(autoincrement())
  codprov               String?
  codarticulo           String?
  articulo              String
  descripcion           String?
  medida                String?
  precio                Decimal?                @db.Decimal(10, 2)
  alicuota              Decimal?                @db.Decimal(5, 2)
  categoriaId           Int?                    @map("categoria_id")
  marcaId               Int?                    @map("marca_id")
  supplierId            Int?                    @map("supplier_id")
  stockminimo           Int?
  createdAt             DateTime                @default(now()) @map("created_at")
  updatedAt             DateTime                @updatedAt @map("updated_at")
  
  categoria             Categoria?              @relation(fields: [categoriaId], references: [id])
  marca                 Marca?                  @relation(fields: [marcaId], references: [id])
  supplier              Supplier?               @relation(fields: [supplierId], references: [id])
  inventarios           Inventario[]
  imagenes              ArticuloImagen[]
  listasPrecios         ArticuloListaPrecio[]
  facturas              ArticuloFactura[]
  presupuestos          ArticuloPresupuesto[]
  remitos               ArticuloRemito[]
  compraDetalles        CompraDetalle[]
  entregas              Entrega[]

  @@map("articulos")
}

model ArticuloImagen {
  id              Int      @id @default(autoincrement())
  articuloId      Int      @map("articulo_id")
  nombreArchivo   String   @map("nombre_archivo")
  ruta            String
  esPrincipal     Boolean  @default(false) @map("es_principal")
  orden           Int      @default(0)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  
  articulo        Articulo @relation(fields: [articuloId], references: [id], onDelete: Cascade)

  @@map("articulo_imagenes")
}

model ListaPrecio {
  id                Int                     @id @default(autoincrement())
  nombre            String
  porcentaje        Decimal                 @db.Decimal(5, 2)
  defaultPos        Boolean                 @default(false) @map("default_pos")
  defaultEcommerce  Boolean                 @default(false) @map("default_ecommerce")
  createdAt         DateTime                @default(now()) @map("created_at")
  updatedAt         DateTime                @updatedAt @map("updated_at")
  
  articulos         ArticuloListaPrecio[]
  facturas          Factura[]

  @@map("listas_precios")
}

model ArticuloListaPrecio {
  id            Int          @id @default(autoincrement())
  articuloId    Int          @map("articulo_id")
  listaPrecioId Int          @map("lista_precio_id")
  precio        Decimal      @db.Decimal(10, 2)
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")
  
  articulo      Articulo     @relation(fields: [articuloId], references: [id], onDelete: Cascade)
  listaPrecio   ListaPrecio  @relation(fields: [listaPrecioId], references: [id], onDelete: Cascade)

  @@map("articulo_lista_precio")
}

model Inventario {
  id           Int       @id @default(autoincrement())
  cantidad     Decimal   @db.Decimal(10, 2)
  lote         String?
  vencimiento  DateTime?
  articuloId   Int       @map("articulo_id")
  supplierId   Int?      @map("supplier_id")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  
  articulo     Articulo  @relation(fields: [articuloId], references: [id])
  supplier     Supplier? @relation(fields: [supplierId], references: [id])

  @@map("inventarios")
}

model Factura {
  id                 Int             @id @default(autoincrement())
  ptoventa           Int
  codcomprobante     String?
  letracomprobante   String?
  numfactura         Int
  cuit               String?
  fecha              DateTime
  bonificacion       Decimal?        @db.Decimal(10, 2)
  recargo            Decimal?        @db.Decimal(10, 2)
  descuento          Decimal?        @db.Decimal(10, 2)
  subtotal           Decimal         @db.Decimal(10, 2)
  total              Decimal         @db.Decimal(10, 2)
  pagada             Boolean         @default(false)
  condicionventa     String?
  comprobanteafip    String?
  cae                String?
  fechavto           DateTime?
  codbarra           String?
  clienteId          Int             @map("cliente_id")
  userId             Int?            @map("user_id")
  compago            Boolean         @default(false)
  listaPrecioId      Int?            @map("lista_precio_id")
  tipoVenta          String?         @map("tipo_venta")
  vencimientoCae     DateTime?       @map("vencimiento_cae")
  autorizadaAfip     Boolean         @default(false) @map("autorizada_afip")
  createdAt          DateTime        @default(now()) @map("created_at")
  updatedAt          DateTime        @updatedAt @map("updated_at")
  deletedAt          DateTime?       @map("deleted_at")
  
  cliente            Cliente         @relation(fields: [clienteId], references: [id])
  user               User?           @relation(fields: [userId], references: [id])
  listaPrecio        ListaPrecio?    @relation(fields: [listaPrecioId], references: [id])
  articulos          ArticuloFactura[]
  pagos              FacturaPago[]
  entregas           Entrega[]

  @@map("facturas")
}

model ArticuloFactura {
  id              Int      @id @default(autoincrement())
  facturaId       Int      @map("factura_id")
  articuloId      Int      @map("articulo_id")
  codprov         String?
  codarticulo     String?
  articulo        String
  medida          String?
  cantidad        Decimal  @db.Decimal(10, 2)
  bonificacion    Decimal? @db.Decimal(10, 2)
  alicuota        Decimal? @db.Decimal(5, 2)
  preciounitario  Decimal  @db.Decimal(10, 2)
  subtotal        Decimal  @db.Decimal(10, 2)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  
  factura         Factura  @relation(fields: [facturaId], references: [id], onDelete: Cascade)
  articuloRef     Articulo @relation(fields: [articuloId], references: [id])

  @@map("articulo_factura")
}

model FacturaPago {
  id             Int      @id @default(autoincrement())
  facturaId      Int      @map("factura_id")
  monto          Decimal  @db.Decimal(10, 2)
  metodoPago     String   @map("metodo_pago")
  fechaPago      DateTime @map("fecha_pago")
  observaciones  String?
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  
  factura        Factura  @relation(fields: [facturaId], references: [id], onDelete: Cascade)

  @@map("factura_pagos")
}

model Entrega {
  id             Int      @id @default(autoincrement())
  facturaId      Int      @map("factura_id")
  articuloId     Int      @map("articulo_id")
  cantidad       Decimal  @db.Decimal(10, 2)
  fechaEntrega   DateTime @map("fecha_entrega")
  observaciones  String?
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  
  factura        Factura  @relation(fields: [facturaId], references: [id], onDelete: Cascade)
  articulo       Articulo @relation(fields: [articuloId], references: [id])

  @@map("entregas")
}

model Presupuesto {
  id                 Int                   @id @default(autoincrement())
  ptoventa           Int
  letracomprobante   String?
  numpresupuesto     Int
  cuit               String?
  fecha              DateTime
  bonificacion       Decimal?              @db.Decimal(10, 2)
  recargo            Decimal?              @db.Decimal(10, 2)
  subtotal           Decimal               @db.Decimal(10, 2)
  total              Decimal               @db.Decimal(10, 2)
  clienteId          Int                   @map("cliente_id")
  userId             Int?                  @map("user_id")
  createdAt          DateTime              @default(now()) @map("created_at")
  updatedAt          DateTime              @updatedAt @map("updated_at")
  
  cliente            Cliente               @relation(fields: [clienteId], references: [id])
  user               User?                 @relation(fields: [userId], references: [id])
  articulos          ArticuloPresupuesto[]

  @@map("presupuestos")
}

model ArticuloPresupuesto {
  id              Int          @id @default(autoincrement())
  presupuestoId   Int          @map("presupuesto_id")
  articuloId      Int          @map("articulo_id")
  codprov         String?
  codarticulo     String?
  articulo        String
  medida          String?
  cantidad        Decimal      @db.Decimal(10, 2)
  bonificacion    Decimal?     @db.Decimal(10, 2)
  alicuota        Decimal?     @db.Decimal(5, 2)
  preciounitario  Decimal      @db.Decimal(10, 2)
  subtotal        Decimal      @db.Decimal(10, 2)
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")
  
  presupuesto     Presupuesto  @relation(fields: [presupuestoId], references: [id], onDelete: Cascade)
  articuloRef     Articulo     @relation(fields: [articuloId], references: [id])

  @@map("articulo_presupuesto")
}

model Remito {
  id                    Int              @id @default(autoincrement())
  ptoventa              Int
  numremito             Int
  fecha                 DateTime
  recargo               Decimal?         @db.Decimal(10, 2)
  bonificacion          Decimal?         @db.Decimal(10, 2)
  subtotal              Decimal          @db.Decimal(10, 2)
  total                 Decimal          @db.Decimal(10, 2)
  supplierId            Int              @map("supplier_id")
  userId                Int?             @map("user_id")
  convertidoInventario  Boolean          @default(false) @map("convertido_inventario")
  createdAt             DateTime         @default(now()) @map("created_at")
  updatedAt             DateTime         @updatedAt @map("updated_at")
  
  supplier              Supplier         @relation(fields: [supplierId], references: [id])
  user                  User?            @relation(fields: [userId], references: [id])
  detalles              ArticuloRemito[]

  @@map("remitos")
}

model ArticuloRemito {
  id              Int      @id @default(autoincrement())
  remitoId        Int      @map("remito_id")
  articuloId      Int      @map("articulo_id")
  codprov         String?
  codarticulo     String?
  articulo        String
  medida          String?
  cantidad        Decimal  @db.Decimal(10, 2)
  bonificacion    Decimal? @db.Decimal(10, 2)
  alicuota        Decimal? @db.Decimal(5, 2)
  preciounitario  Decimal  @db.Decimal(10, 2)
  subtotal        Decimal  @db.Decimal(10, 2)
  lote            String?
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  
  remito          Remito   @relation(fields: [remitoId], references: [id], onDelete: Cascade)
  articuloRef     Articulo @relation(fields: [articuloId], references: [id])

  @@map("articulo_remito")
}

model Compra {
  id              Int             @id @default(autoincrement())
  numeroRemito    String          @map("numero_remito")
  fecha           DateTime
  supplierId      Int             @map("supplier_id")
  subtotal        Decimal         @db.Decimal(10, 2)
  total           Decimal         @db.Decimal(10, 2)
  observaciones   String?
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")
  
  supplier        Supplier        @relation(fields: [supplierId], references: [id])
  detalles        CompraDetalle[]

  @@map("compras")
}

model CompraDetalle {
  id             Int      @id @default(autoincrement())
  compraId       Int      @map("compra_id")
  articuloId     Int      @map("articulo_id")
  cantidad       Decimal  @db.Decimal(10, 2)
  precioUnitario Decimal  @db.Decimal(10, 2) @map("precio_unitario")
  subtotal       Decimal  @db.Decimal(10, 2)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  
  compra         Compra   @relation(fields: [compraId], references: [id], onDelete: Cascade)
  articulo       Articulo @relation(fields: [articuloId], references: [id])

  @@map("compra_detalles")
}

model Provincia {
  id          Int          @id @default(autoincrement())
  nombre      String
  idAfip      Int?         @map("id_afip")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")
  
  localidades Localidad[]

  @@map("provincias")
}

model Localidad {
  id           Int       @id @default(autoincrement())
  nombre       String
  provinciaId  Int       @map("provincia_id")
  idAfip       Int?      @map("id_afip")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  
  provincia    Provincia @relation(fields: [provinciaId], references: [id])

  @@map("localidades")
}

model InitialSetting {
  id                  Int      @id @default(autoincrement())
  cuit                BigInt
  razonsocial         String
  direccion           String?
  telefono            String?
  email               String?
  codigopostal        Int?
  localidad           String?
  provincia           String?
  condicioniva        String?
  inicioactividades   String?
  puntoventa          Int?
  nombrefantasia      String?
  domiciliocomercial  String?
  tagline             String?
  logo                String?
  numfactura          Int?
  numremito           Int?
  numpresupuesto      Int?
  numpago             Int?
  numrecibo           Int?
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  @@map("inicialsettings")
}
