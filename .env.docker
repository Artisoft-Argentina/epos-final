APP_NAME=EPOS
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://epos.lvh.me:3000
APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_AR

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# Base de datos central (la app usa epos_user, que tiene GRANT ALL via mysql-init.sql)
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=epos_central
DB_USERNAME=epos_user
DB_PASSWORD=epos_password

# ──────────────────────────────────────────────
# MULTITENANT — Configuración crítica
# ──────────────────────────────────────────────
# Dominio central donde vive el panel de administración de empresas
CENTRAL_DOMAIN=epos.lvh.me

# Prefijo para las bases de datos de cada tenant
# Ejemplo: empresa "acme" → DB: epos_acme-uuid
TENANCY_DB_PREFIX=epos_

# Dominio de sesión: debe cubrir todos los subdominios (empieza con punto)
SESSION_DOMAIN=.lvh.me
# ──────────────────────────────────────────────

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@epos.local"
MAIL_FROM_NAME="${APP_NAME}"

# ──────────────────────────────────────────────
# AFIP
# ──────────────────────────────────────────────
AFIP_CUIT=
AFIP_ENVIRONMENT=homologacion
AFIP_CERTIFICATE_PATH=storage/app/private/afip/cert.pem
AFIP_KEY_PATH=storage/app/private/afip/key.pem

# ──────────────────────────────────────────────
# MercadoPago (usar credenciales TEST para local)
# ──────────────────────────────────────────────
MERCADOPAGO_ACCESS_TOKEN=TEST-
MERCADOPAGO_PUBLIC_KEY=TEST-

# ──────────────────────────────────────────────
# Telegram Bots (opcional en local)
# ──────────────────────────────────────────────
TELEGRAM_BOT_ADMIN_TOKEN=
TELEGRAM_BOT_VENDEDOR_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# ──────────────────────────────────────────────
# IA / LLM
# ──────────────────────────────────────────────
AI_PROVIDER=groq
GROQ_API_KEY=

# Alternativa local sin internet (requiere Ollama corriendo fuera del contenedor)
# AI_PROVIDER=ollama
# OLLAMA_API_URL=http://host.docker.internal:11434
# OLLAMA_MODEL=llama3.2:3b

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ──────────────────────────────────────────────
# Asistente de Compras (OCR)
# ──────────────────────────────────────────────
PDF_PROCESSOR_API_URL=http://localhost:3001
